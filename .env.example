# ==============================================================================
# Google Antigravity & GCP Thinking Partner Configuration
# ==============================================================================

# Option 1: Google AI Studio API Key (Fastest for local testing)
GEMINI_API_KEY=

# Option 2: Google Cloud Vertex AI
USE_VERTEX_AI=true
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=global

# Model selection (Flagship Gemini 3.7 Flash)
GEMINI_MODEL=gemini-3.7-flash

# Storage mode: 'memory' (with automatic JSON file checkpointing) or 'firestore'
STORAGE_MODE=memory

# Set to true to test deterministic state machine without calling external LLMs
USE_MOCK_LLM=false

# Domain Fluidity Dials
DOMAIN_SWITCH_THRESHOLD=0.60
DOMAIN_MARGIN=0.15
DOMAIN_HYSTERESIS=2
DOMAIN_BLEND=true
